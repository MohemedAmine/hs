<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teacher Load</title>
  <link rel="shortcut icon" href="#">
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      block-size: 100vh;
      background-color: #f5f5f5;
    }

    .container {
      inline-size: 80%;
      max-inline-size: 800px;
      background: #ffffff;
      padding: 20px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      margin-block-end: 20px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-block-end: 20px;
    }

    .header h2 {
      margin: 0;
    }

    .header select {
      padding: 5px;
      font-size: 16px;
    }

    .table {
      inline-size: 100%;
      border-collapse: collapse;
    }

    .table .row {
      display: flex;
      justify-content: space-between;
      border-block-end: 1px solid #ddd;
      padding: 10px 0;
    }

    .table .row:last-child {
      border-block-end: none;
    }

    .table .cell {
      flex: 1;
      text-align: center;
    }

    .table .cell span {
      display: block;
    }

    .total {
      background-color: #ffcc00;
      font-weight: bold;
      padding: 10px;
    }
  </style>
</head>
<body>
<input type="hidden" id="teacherId" name="teacherId" value="<%= enseignantId %>">
<div class="container">
  <!-- Section for filtering by month and year -->
  <div class="header">
    <h2>Teacher Load by Month and Year</h2>
    <select id="monthSelect"></select>
    <select id="yearSelect"></select>
  </div>
  <div id="monthYearTable" class="table">
    <!-- Content will be populated by JavaScript -->
  </div>
</div>

<div class="container">
  <!-- Section for filtering by session -->
  <div class="header">
    <h2>Teacher Load by Session</h2>
    <select id="sessionSelect">
      <!-- Options will be populated by JavaScript -->
    </select>
  </div>
  <div id="sessionTable" class="table">
    <!-- Content will be populated by JavaScript -->
  </div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
  $(document).ready(function () {
    const monthNames = ["JANVIER", "FÉVRIER", "MARS", "AVRIL", "MAI", "JUIN", "JUILLET", "AOÛT", "SEPTEMBRE", "OCTOBRE", "NOVEMBRE", "DÉCEMBRE"];
    const currentMonth = new Date().getMonth();
    const currentYear = new Date().getFullYear();
    const teacherId = document.getElementById('teacherId').value;

    // Populate month and year select
    for (let i = 0; i < 12; i++) {
      $('#monthSelect').append(new Option(monthNames[i], i + 1, i === currentMonth, i === currentMonth));
    }
    for (let year = currentYear - 5; year <= currentYear + 5; year++) {
      $('#yearSelect').append(new Option(year, year, year === currentYear, year === currentYear));
    }

    // Fetch and populate sessions
    function populateSessions() {
      $.ajax({
        url: '/getSessions', // Your backend API endpoint to fetch sessions
        method: 'GET',
        success: function (sessions) {
          sessions.forEach(session => {
            $('#sessionSelect').append(new Option(`${formatDate(session.begin)} - ${formatDate(session.end)}`, session._id));
          });

          // Restore previous session selection from localStorage if available
          const previousSessionId = localStorage.getItem('selectedSessionId');
          if (previousSessionId) {
            $('#sessionSelect').val(previousSessionId).trigger('change');
          }
        },
        error: function (error) {
          console.error(error);
        }
      });
    }

    populateSessions();

    // Function to fetch and display data by month and year
    function fetchAndDisplayData(month, year) {
      $.ajax({
        url: '/getTeacherLoad', // Your backend API endpoint
        method: 'GET',
        data: {
          enseignantId: teacherId,
          month: month,
          year: year
        },
        success: function (data) {
          displayData(data, '#monthYearTable');
        },
        error: function (error) {
          console.error(error);
        }
      });
    }

    // Function to fetch and display data by session
    function fetchAndDisplayDataBySession(sessionId) {
      $.ajax({
        url: '/getTeacherLoadBySession', // Your backend API endpoint
        method: 'GET',
        data: {
          enseignantId: teacherId,
          sessionId: sessionId
        },
        success: function (data) {
          displayData(data, '#sessionTable');
        },
        error: function (error) {
          console.error(error);
        }
      });
    }

    // Function to display data in the table
    function displayData(data, tableSelector) {
      $(tableSelector).empty();
      data.forEach(weekData => {
        if (weekData.week && weekData.week.length > 0) {
          const row = $('<div>').addClass('row');
          const weekStart = weekData.week[0];
          const weekEnd = weekData.week[weekData.week.length - 1];
          const weekDisplay = weekStart === weekEnd ? weekStart : `${weekStart} - ${weekEnd}`;
          row.append($('<div>').addClass('cell').html(`<span>${weekDisplay}</span>`));
          row.append($('<div>').addClass('cell').html(`<span>${weekData.load} heures</span>`));
          $(tableSelector).append(row);
        }
      });

      const totalLoad = data.reduce((acc, weekData) => acc + weekData.load, 0);
      const totalRow = $('<div>').addClass('row total').html(`<span>Total:</span><span>${totalLoad} heures</span>`);
      $(tableSelector).append(totalRow);
    }

    // Function to format date to a readable string
    function formatDate(dateString) {
      const options = { year: 'numeric', month: 'short', day: 'numeric' };
      return new Date(dateString).toLocaleDateString('fr-FR', options);
    }

    // Initial load for the current month and year
    fetchAndDisplayData(currentMonth + 1, currentYear);

    // Event listeners for month and year selection
    $('#monthSelect, #yearSelect').change(function () {
      const month = $('#monthSelect').val();
      const year = $('#yearSelect').val();
      fetchAndDisplayData(month, year);
    });

    // Event listener for session selection
    $('#sessionSelect').change(function () {
      const sessionId = $('#sessionSelect').val();
      localStorage.setItem('selectedSessionId', sessionId); // Save selected session to localStorage
      fetchAndDisplayDataBySession(sessionId);
    });
  });
</script>
</body>
</html>
