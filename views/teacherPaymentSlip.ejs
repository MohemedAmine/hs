<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teacher Payment Slip</title>
  <link rel="shortcut icon" href="#">
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      block-size: 100vh;
      background-color: #f5f5f5;
    }
    .container {
      inline-size: 80%;
      max-inline-size: 800px;
      background: #ffffff;
      padding: 20px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      margin-block-start: 20px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-block-end: 20px;
    }
    .header h2 {
      margin: 0;
    }
    .header select {
      padding: 5px;
      font-size: 16px;
    }
    .table {
      inline-size: 100%;
      border-collapse: collapse;
    }
    .table .row {
      display: flex;
      justify-content: space-between;
      border-block-end: 1px solid #ddd;
      padding: 10px 0;
    }
    .table .row:last-child {
      border-block-end: none;
    }
    .table .cell {
      flex: 1;
      text-align: center;
    }
    .table .cell span {
      display: block;
    }
    .total {
      background-color: #ffcc00;
      font-weight: bold;
      padding: 10px;
    }
    #generatePdfBtn {
      margin-block-start: 20px;
      padding: 10px 20px;
      background-color: #007bff;
      color: #fff;
      border: none;
      cursor: pointer;
      font-size: 16px;
    }
  </style>
</head>
<body>
<input type="hidden" id="teacherId" name="teacherId" value="<%= enseignantId %>">
<div class="container">
  <!-- Section for filtering by session -->
  <div class="header">
    <h2>Teacher Payment Slip</h2>
    <select id="sessionSelect">
      <!-- Options will be populated by JavaScript -->
    </select>
  </div>
  <div id="paymentTable" class="table">
    <!-- Content will be populated by JavaScript -->
  </div>
  <button id="generatePdfBtn">Generate PDF</button>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.3.1/jspdf.umd.min.js"></script>
<script>
  $(document).ready(function () {
    const teacherId = document.getElementById('teacherId').value;

    // Fetch and populate sessions
    function populateSessions() {
      $('#spinner').show();
      $.ajax({
        url: '/getSessions', // Your backend API endpoint to fetch sessions
        method: 'GET',
        success: function (sessions) {
          sessions.forEach(session => {
            $('#sessionSelect').append(new Option(`${formatDate(session.begin)} - ${formatDate(session.end)}`, session._id));
          });

          // Restore previous session selection from localStorage if available
          const previousSessionId = localStorage.getItem('selectedSessionId');
          if (previousSessionId) {
            $('#sessionSelect').val(previousSessionId).trigger('change');
          }
          $('#spinner').hide();
        },
        error: function (error) {
          console.error(error);
          $('#spinner').hide();
        }
      });
    }

    populateSessions();

    // Function to fetch and display data by session
    function fetchAndDisplayDataBySession(sessionId) {
      $('#spinner').show();
      $.ajax({
        url: '/paymentSlip', // Your backend API endpoint
        method: 'GET',
        data: {
          enseignantId: teacherId,
          sessionId: sessionId
        },
        success: function (data) {
          displayData(data, '#paymentTable');
          $('#spinner').hide();
        },
        error: function (error) {
          console.error(error);
          $('#spinner').hide();
        }
      });
    }

    // Function to display data in the table
    function displayData(data, tableSelector) {
      $(tableSelector).empty();
      data.forEach(payment => {
        const row = $('<div>').addClass('row');
        row.append($('<div>').addClass('cell').html(`<span>${formatDate(payment.date)}</span>`));
        row.append($('<div>').addClass('cell').html(`<span>${payment.description}</span>`));
        row.append($('<div>').addClass('cell').html(`<span>${payment.hoursWorked} hours</span>`));
        row.append($('<div>').addClass('cell').html(`<span>${payment.amount} USD</span>`));
        $(tableSelector).append(row);
      });

      const totalAmount = data.reduce((acc, payment) => acc + payment.amount, 0);
      const totalRow = $('<div>').addClass('row total').html(`<span>Total: ${totalAmount} USD</span>`);
      $(tableSelector).append(totalRow);
    }

    // Function to format date to a readable string
    function formatDate(dateString) {
      const options = { year: 'numeric', month: 'short', day: 'numeric' };
      return new Date(dateString).toLocaleDateString('en-US', options);
    }

    // Event listener for session selection
    $('#sessionSelect').change(function () {
      const sessionId = $('#sessionSelect').val();
      localStorage.setItem('selectedSessionId', sessionId); // Save selected session to localStorage
      fetchAndDisplayDataBySession(sessionId);
    });

    // Event listener for generating PDF
    $('#generatePdfBtn').click(function () {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();

      doc.setFont('Helvetica', 'bold');
      doc.setFontSize(18);
      doc.text("Teacher Payment Slip", 14, 20);

      doc.setFont('Helvetica', 'normal');
      doc.setFontSize(12);
      const headers = ["Date", "Description", "Hours Worked", "Amount (USD)"];
      const startX = [14, 64, 114, 164];
      const startY = 30;

      // Draw headers
      headers.forEach((header, index) => {
        doc.text(header, startX[index], startY);
      });

      // Draw data rows
      let y = startY + 10;
      $('#paymentTable .row').each(function () {
        const cells = $(this).find('.cell span');
        cells.each((index, cell) => {
          doc.text($(cell).text(), startX[index], y);
        });
        y += 10;
      });

      // Save the PDF
      doc.save('payment_slip.pdf');
    });
  });
</script>

</body>
</html>
